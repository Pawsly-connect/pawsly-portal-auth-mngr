{
  "name": "pawsly-portal-auth-mngr",
  "version": "1.0.0",
  "description": "Manager de autenticacion del portal de pawsly",
  "main": "build/server.js",
  "scripts": {
    "lint": "tslint -c tslint.json -p tsconfig.json",
    "lint:fix": "npm run lint --fix",
    "build": "npm run lint:fix && tsc",
    "start:local": "cross-env NODE_ENV=local DEBUG=paw:* DEBUG_COLORS=false nodemon .",
    "start": "cross-env DEBUG=paw:* node .",
    "test": "cross-env NODE_ENV=local KEY_AES=123456123456123456 KEY_IV=abc123abc123 DEBUG=paw:* mocha --timeout 10000 --require ts-node/register 'test/**/*.spec.ts' --exit",
    "test:coverage": "cross-env NODE_ENV=local KEY_AES=123456123456123456 KEY_IV=abc123abc123 DEBUG=paw:* nyc --reporter=lcov mocha --require ts-node/register 'test/**/*.spec.ts' --exit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Pawsly-connect/pawsly-portal-auth-mngr"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.533.0",
    "@aws-sdk/lib-dynamodb": "^3.533.0",
    "aws-serverless-express": "^3.4.0",
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "debug": "^4.3.4",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-session": "^1.18.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.13",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "swig-email-templates": "^7.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/aws-serverless-express": "^3.3.9",
    "@types/axios": "^0.14.0",
    "@types/chai": "^4.2.18",
    "@types/cors": "^2.8.17",
    "@types/debug": "^4.1.12",
    "@types/express": "^4.17.21",
    "@types/mocha": "^8.2.2",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.12.5",
    "@types/nodemailer": "^6.4.14",
    "@types/passport": "^1.0.16",
    "@types/sinon": "^17.0.3",
    "@types/supertest": "^6.0.2",
    "@types/swig-email-templates": "^7.0.3",
    "chai": "^4.3.4",
    "mocha": "^8.4.0",
    "nodemon": "^3.1.0",
    "nyc": "^15.1.0",
    "sinon": "^17.0.1",
    "supertest": "^6.3.4",
    "ts-node": "^10.0.0",
    "tslint": "^6.1.3",
    "typescript": "^4.3.2",
    "typescript-tslint-plugin": "^1.0.2"
  }
}
