{
  "openapi": "3.0.2",
  "info": {
    "title": "Pawsly auth API",
    "version": "1.0.0",
    "description": "API encargada de la autenticacion de clientes en el portal de pawsly"
  },
  "servers": [
    {
      "url": "https://{st-domain}",
      "description": "Ambiente ST",
      "variables": {
        "st-domain": {
          "default": "1vd78290pl.execute-api.us-east-1.amazonaws.com"
        }
      }
    },
    {
      "url": "https://{prod-domain}",
      "description": "Ambiente PROD",
      "variables": {
        "prod-domain": {
          "default": "1vd78290pl.execute-api.us-east-1.amazonaws.com"
        }
      }
    }
  ],
  "paths": {
    "/V1/user/register": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRegisterRequest"
              }
            }
          },
          "required": true
        },
        "parameters": [
          {
            "name": "X-Name",
            "description": "Nombre de la aplicación que consume la API",
            "schema": {
              "enum": [
                "Portal",
                "App"
              ],
              "type": "string"
            },
            "in": "header",
            "required": true
          },
          {
            "name": "X-API-KEY",
            "description": "Token de autenticación",
            "schema": {
              "maxLength": 321,
              "minLength": 1,
              "pattern": "^(?!.*<[^>]+>).*$",
              "type": "string"
            },
            "in": "header"
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/clientResponse"
                }
              }
            },
            "description": "Respuesta cuando el usuario es registrado exitosamente"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Response when the API consumer is not authorized"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/clientResponse"
                }
              }
            },
            "description": "Respuesta cuando el servidor obtiene un error de negocio"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/clientResponse"
                }
              }
            },
            "description": "Respuesta cuando el servidor obtiene un fallo inesperado"
          }
        },
        "security": [
          {
            "api_key": []
          }
        ],
        "summary": "Registrar un nuevo usuario",
        "description": "Metodo que permite registrar a un usuario en Pawsly",
        "x-amazon-apigateway-integration": {
          "uri": "${lbda_pawsly_auth_mngr}",
          "httpMethod": "POST",
          "responses": {
            "default": {
              "statusCode": "201"
            }
          },
          "passthroughBehavior": "when_no_match",
          "contentHandling": "CONVERT_TO_TEXT",
          "type": "aws_proxy"
        }
      }
    },
    "/V1/user/login": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserLoginRequest"
              }
            }
          },
          "required": true
        },
        "parameters": [
          {
            "name": "X-Name",
            "description": "Nombre de la aplicación que consume la API",
            "schema": {
              "enum": [
                "Portal",
                "App"
              ],
              "type": "string"
            },
            "in": "header",
            "required": true
          },
          {
            "name": "X-API-KEY",
            "description": "Token de autenticación",
            "schema": {
              "maxLength": 321,
              "minLength": 1,
              "pattern": "^(?!.*<[^>]+>).*$",
              "type": "string"
            },
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/clientResponse"
                }
              }
            },
            "description": "Respuesta cuando el usuario es ingresado exitosamente"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Response when the API consumer is not authorized"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/clientResponse"
                }
              }
            },
            "description": "Respuesta cuando el servidor obtiene un error de negocio"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/clientResponse"
                }
              }
            },
            "description": "Respuesta cuando el servidor obtiene un fallo inesperado"
          }
        },
        "security": [
          {
            "api_key": []
          }
        ],
        "summary": "Registrar un nuevo usuario",
        "description": "Metodo que permite ingresar un usuario en Pawsly",
        "x-amazon-apigateway-integration": {
          "uri": "${lbda_pawsly_auth_mngr}",
          "httpMethod": "POST",
          "responses": {
            "default": {
              "statusCode": "200"
            }
          },
          "passthroughBehavior": "when_no_match",
          "contentHandling": "CONVERT_TO_TEXT",
          "type": "aws_proxy"
        }
      }
    },
    "/V1/user/verification": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserVerificationRequest"
              }
            }
          },
          "required": true
        },
        "parameters": [
          {
            "name": "X-Name",
            "description": "Nombre de la aplicación que consume la API",
            "schema": {
              "enum": [
                "Portal",
                "App"
              ],
              "type": "string"
            },
            "in": "header",
            "required": true
          },
          {
            "name": "X-API-KEY",
            "description": "Token de autenticación",
            "schema": {
              "maxLength": 321,
              "minLength": 1,
              "pattern": "^(?!.*<[^>]+>).*$",
              "type": "string"
            },
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/clientResponse"
                }
              }
            },
            "description": "Respuesta cuando el usuario es ingresado exitosamente"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Response when the API consumer is not authorized"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/clientResponse"
                }
              }
            },
            "description": "Respuesta cuando el servidor obtiene un error de negocio"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/clientResponse"
                }
              }
            },
            "description": "Respuesta cuando el servidor obtiene un fallo inesperado"
          }
        },
        "security": [
          {
            "api_key": []
          }
        ],
        "summary": "Registrar un nuevo usuario",
        "description": "Metodo que permite ingresar un usuario en Pawsly",
        "x-amazon-apigateway-integration": {
          "uri": "${lbda_pawsly_auth_mngr}",
          "httpMethod": "POST",
          "responses": {
            "default": {
              "statusCode": "200"
            }
          },
          "passthroughBehavior": "when_no_match",
          "contentHandling": "CONVERT_TO_TEXT",
          "type": "aws_proxy"
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserRegisterRequest": {
        "description": "UserRegisterRequest",
        "required": [
          "email",
          "password",
          "city",
          "name"
        ],
        "type": "object",
        "properties": {
          "email": {
            "description": "email del usuario a registrar",
            "maxLength": 100,
            "minLength": 5,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "type": "string",
            "additionalProperties": false
          },
          "password": {
            "description": "password del usuario a registrar",
            "maxLength": 100,
            "minLength": 8,
            "pattern": "^.*(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[^a-zA-Z0-9])(?=\\S{8,}).*$",
            "type": "string",
            "additionalProperties": false
          },
          "city": {
            "description": "ciudad del usuario a registrar",
            "maxLength": 60,
            "minLength": 1,
            "type": "string",
            "additionalProperties": false
          },
          "name": {
            "description": "Nombre del usuario a registrar",
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "UserLoginRequest": {
        "description": "UserLoginRequest",
        "required": [
          "email",
          "password",
          "city",
          "name"
        ],
        "type": "object",
        "properties": {
          "email": {
            "description": "email del usuario a ingresar",
            "maxLength": 100,
            "minLength": 5,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "type": "string",
            "additionalProperties": false
          },
          "password": {
            "description": "password del usuario a ingresar",
            "maxLength": 100,
            "minLength": 8,
            "pattern": "^.*(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[^a-zA-Z0-9]).*$",
            "type": "string",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "UserVerificationRequest": {
        "description": "UserVerificationRequest",
        "required": [
          "key"
        ],
        "type": "object",
        "properties": {
          "key": {
            "description": "llave del usuario a verificar",
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9=]+$",
            "type": "string",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "clientResponse": {
        "description": "clientResponse",
        "required": [
          "code",
          "msg"
        ],
        "type": "object",
        "properties": {
          "code": {
            "description": "code",
            "minimum": 1000,
            "maximum": 3999,
            "type": "number"
          },
          "msg": {
            "description": "msg",
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "api_key": {
        "type": "apiKey",
        "name": "x-api-key",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "api_key": []
    }
  ],
  "x-amazon-apigateway-request-validators": {
    "Validate body, query string parameters, and headers": {
      "validateRequestParameters": true,
      "validateRequestBody": true
    }
  }
}