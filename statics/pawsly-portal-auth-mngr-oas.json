{
	"openapi": "3.0.2",
	"info": {
		"title": "Pawsly auth API",
		"version": "1.0.0",
		"description": "API encargada de la autenticacion de clientes en el portal de pawsly"
	},
	"servers": [
		{
			"url": "https://{st-domain}",
			"description": "Ambiente ST",
			"variables": {
				"st-domain": {
					"default": "1vd78290pl.execute-api.us-east-1.amazonaws.com"
				}
			}
		},
		{
			"url": "https://{prod-domain}",
			"description": "Ambiente PROD",
			"variables": {
				"prod-domain": {
					"default": "1vd78290pl.execute-api.us-east-1.amazonaws.com"
				}
			}
		}
	],
	"paths": {
		"/V1/user/register": {
			"post": {
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/CipherRequest"
							}
						}
					},
					"required": true
				},
				"parameters": [
					{
						"name": "X-Name",
						"description": "Nombre de la aplicación que consume la API",
						"schema": {
							"enum": ["Portal", "App"],
							"type": "string"
						},
						"in": "header",
						"required": true
					},
					{
						"name": "X-API-KEY",
						"description": "Token de autenticación",
						"schema": {
							"maxLength": 321,
							"minLength": 1,
							"pattern": "^(?!.*<[^>]+>).*$",
							"type": "string"
						},
						"in": "header"
					}
				],
				"responses": {
					"201": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/clientResponse"
								}
							}
						},
						"description": "Respuesta cuando el usuario es registrado exitosamente"
					},
					"401": {
						"description": "Unauthorized"
					},
					"403": {
						"description": "Response when the API consumer is not authorized"
					},
					"400": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/clientResponse"
								}
							}
						},
						"description": "Respuesta cuando el servidor obtiene un error de negocio"
					},
					"500": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/clientResponse"
								}
							}
						},
						"description": "Respuesta cuando el servidor obtiene un fallo inesperado"
					}
				},
				"security": [
					{
						"api_key": []
					}
				],
				"summary": "Registrar un nuevo usuario",
				"description": "Metodo que permite registrar a un usuario en Pawsly",
				"x-amazon-apigateway-integration": {
					"uri": "${lbda_pawsly_auth_mngr}",
					"httpMethod": "POST",
					"responses": {
						"default": {
							"statusCode": "201"
						}
					},
					"passthroughBehavior": "when_no_match",
					"contentHandling": "CONVERT_TO_TEXT",
					"type": "aws_proxy"
				}
			}
		},
		"/V1/user/login": {
			"post": {
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/CipherRequest"
							}
						}
					},
					"required": true
				},
				"parameters": [
					{
						"name": "X-Name",
						"description": "Nombre de la aplicación que consume la API",
						"schema": {
							"enum": ["Portal", "App"],
							"type": "string"
						},
						"in": "header",
						"required": true
					},
					{
						"name": "X-API-KEY",
						"description": "Token de autenticación",
						"schema": {
							"maxLength": 321,
							"minLength": 1,
							"pattern": "^(?!.*<[^>]+>).*$",
							"type": "string"
						},
						"in": "header"
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/clientResponse"
								}
							}
						},
						"description": "Respuesta cuando el usuario es ingresado exitosamente"
					},
					"401": {
						"description": "Unauthorized"
					},
					"403": {
						"description": "Response when the API consumer is not authorized"
					},
					"400": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/clientResponse"
								}
							}
						},
						"description": "Respuesta cuando el servidor obtiene un error de negocio"
					},
					"500": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/clientResponse"
								}
							}
						},
						"description": "Respuesta cuando el servidor obtiene un fallo inesperado"
					}
				},
				"security": [
					{
						"api_key": []
					}
				],
				"summary": "Registrar un nuevo usuario",
				"description": "Metodo que permite ingresar un usuario en Pawsly",
				"x-amazon-apigateway-integration": {
					"uri": "${lbda_pawsly_auth_mngr}",
					"httpMethod": "POST",
					"responses": {
						"default": {
							"statusCode": "200"
						}
					},
					"passthroughBehavior": "when_no_match",
					"contentHandling": "CONVERT_TO_TEXT",
					"type": "aws_proxy"
				}
			}
		},
		"/V1/user/verification": {
			"post": {
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/CipherRequest"
							}
						}
					},
					"required": true
				},
				"parameters": [
					{
						"name": "X-Name",
						"description": "Nombre de la aplicación que consume la API",
						"schema": {
							"enum": ["Portal", "App"],
							"type": "string"
						},
						"in": "header",
						"required": true
					},
					{
						"name": "X-API-KEY",
						"description": "Token de autenticación",
						"schema": {
							"maxLength": 321,
							"minLength": 1,
							"pattern": "^(?!.*<[^>]+>).*$",
							"type": "string"
						},
						"in": "header"
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/clientResponse"
								}
							}
						},
						"description": "Respuesta cuando el usuario es ingresado exitosamente"
					},
					"401": {
						"description": "Unauthorized"
					},
					"403": {
						"description": "Response when the API consumer is not authorized"
					},
					"400": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/clientResponse"
								}
							}
						},
						"description": "Respuesta cuando el servidor obtiene un error de negocio"
					},
					"500": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/clientResponse"
								}
							}
						},
						"description": "Respuesta cuando el servidor obtiene un fallo inesperado"
					}
				},
				"security": [
					{
						"api_key": []
					}
				],
				"summary": "Registrar un nuevo usuario",
				"description": "Metodo que permite ingresar un usuario en Pawsly",
				"x-amazon-apigateway-integration": {
					"uri": "${lbda_pawsly_auth_mngr}",
					"httpMethod": "POST",
					"responses": {
						"default": {
							"statusCode": "200"
						}
					},
					"passthroughBehavior": "when_no_match",
					"contentHandling": "CONVERT_TO_TEXT",
					"type": "aws_proxy"
				}
			}
		}
	},
	"components": {
		"schemas": {
			"CipherRequest": {
				"description": "Schema to validate cipher request from client",
				"type": "string",
				"minLength": 1,
				"maxLength": 2200,
				"pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{4}|[A-Za-z0-9+/]{3}=|[A-Za-z0-9+/]{2})$"
			},
			"clientResponse": {
				"description": "clientResponse",
				"required": ["code", "msg"],
				"type": "object",
				"properties": {
					"code": {
						"description": "code",
						"minimum": 1000,
						"maximum": 3999,
						"type": "number"
					},
					"msg": {
						"description": "msg",
						"minLength": 1,
						"type": "string"
					}
				},
				"additionalProperties": false
			}
		},
		"securitySchemes": {
			"api_key": {
				"type": "apiKey",
				"name": "x-api-key",
				"in": "header"
			}
		}
	},
	"security": [
		{
			"api_key": []
		}
	],
	"x-amazon-apigateway-request-validators": {
		"Validate body, query string parameters, and headers": {
			"validateRequestParameters": true,
			"validateRequestBody": true
		}
	}
}
